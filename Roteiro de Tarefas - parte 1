# Coordenada média de todos os imóveis
lat_media = df_mapa['latitude'].mean()
lon_media = df_mapa['longitude'].mean()

# Criação do mapa base
mapa_basico = folium.Map(
    location=[lat_media, lon_media],
    zoom_start=12,
    tiles='OpenStreetMap'
)

mapa_basico
